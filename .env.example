# http = backend Go BuildingVision (/api/v1/bvrooms/*); mode utama & satu-satunya saat ini
VITE_API_MODE=http
# slug organization yang dilayani app white-label ini (D1: satu deployment = satu org)
VITE_ORG_SLUG=graha-pangeran
# Base URL API absolut. Kosong = relatif (/api → proxy Vite saat dev / reverse-proxy saat deploy web).
# WAJIB diisi untuk build native Capacitor (Android/iOS), mis. https://api.buildingvision.id
VITE_API_BASE=
# Backend target untuk proxy dev (vite.config.ts)
BV_API_URL=http://localhost:8080
